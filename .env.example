# Copy to .env and set each challenge flag plus the local calibrated thresholds.
PATCHGUARD_FLAG=flag{replace_with_a_different_random_ctf_flag}
PATCHGUARD_CLEAN_THRESHOLD=0.80
PATCHGUARD_ROBUST_THRESHOLD=0.60
PATCHGUARD_POINTS=300
PATCHGUARD_EVALUATOR_VERSION=1
JUPYTER_TOKEN=replace_with_a_long_random_token
CTFD_SECRET_KEY=replace_with_a_random_64_character_secret
CTFD_URL=http://localhost:8001
CTFD_ADMIN_TOKEN=
PARTICIPANT_URL=http://localhost:7000
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_PATCHGUARD_EXPERIMENT_NAME=patchguard
MLFLOW_XRAY_EXPERIMENT_NAME=xray-redblue
MLFLOW_ARENA_EXPERIMENT_NAME=red_blue_arena
MLFLOW_PUBLIC_URL=http://localhost:5000
MLFLOW_LLM_SAFETY_EXPERIMENT_NAME=llm-safety
PARTICIPANT_IMAGE=ai-cyber-participant:local
LAUNCHER_BIND_HOST=127.0.0.1
WORKSPACE_BIND_HOST=127.0.0.1
WORKSPACE_PUBLIC_BASE_URL=http://localhost
WORKSPACE_PORT_START=9001
WORKSPACE_PORT_END=9099
RANGE_DOCKER_NETWORK=ai-cyber-range_default
# Optional workspace sizing; leave blank to use Docker defaults.
WORKSPACE_MEMORY_LIMIT=
WORKSPACE_CPU_LIMIT=
WORKSPACE_GPU_ENABLED=false

# NVIDIA GPU setup (RTX 5090): uncomment both lines to load the CUDA overlay.
# The explicit separator also works on Windows.
# COMPOSE_PATH_SEPARATOR=;
# COMPOSE_FILE=docker-compose.yml;docker-compose.gpu.yml

# Optional X-ray Red/Blue exercise. Build the included xray_base directory
# as adv_demo (or set XRAY_BASE_IMAGE to its local tag).
# Start only when wanted with: docker compose --profile xray-redblue up -d --build xray-redblue arena-service
XRAY_BASE_IMAGE=adv_demo
XRAY_REDBLUE_ENABLED=false
XRAY_RED_FLAG=flag{replace_with_a_random_red_xray_flag}
XRAY_BLUE_FLAG=flag{replace_with_a_different_blue_xray_flag}
XRAY_RED_POINTS=200
XRAY_BLUE_POINTS=300
XRAY_BLUE_MIN_CLEAN_ACCURACY=0.65
XRAY_BLUE_MIN_ADV_RESOLVED=0.55
XRAY_BLUE_MIN_ADV_GAIN=0.05
XRAY_BLUE_MIN_DETECTION_RATE=0.05
XRAY_BLUE_MAX_FALSE_POSITIVE_RATE=0.25
XRAY_TORCH_THREADS=2
XRAY_SAMPLES_PER_CLASS=16
XRAY_CPU_LIMIT=2.0
XRAY_MEMORY_LIMIT=3g
XRAY_EVALUATOR_TIMEOUT=180

# Optional single-student LLM prompt-safety challenge. Assign an existing CTFd
# user ID before enabling; the evaluator rejects all other accounts.
# Start with: docker compose --profile llm-safety up -d --build llm-safety-target
LLM_SAFETY_ENABLED=false
LLM_SAFETY_ALLOWED_USER_ID=
LLM_SAFETY_FLAG=flag{replace_with_a_unique_llm_safety_flag}
LLM_SAFETY_POINTS=400
